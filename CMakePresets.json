{
  "version": 7,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CUDA_COMPILER": "nvcc"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": [
        "base",
        "gcc"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-relwithdebinfo",
      "displayName": "GCC Release with Debug Info",
      "inherits": [
        "base",
        "gcc"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": [
        "base",
        "clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-relwithdebinfo",
      "displayName": "Clang Release with Debug Info",
      "inherits": [
        "base",
        "clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "dev-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "dev-gcc-warnings",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wnon-virtual-dtor -Wunused -Wshadow",
        "CMAKE_CUDA_FLAGS": "--Wreorder --Wdefault-stream-launch --Wmissing-launch-bounds --Wext-lambda-captures-this -Xptxas --warn-on-local-memory-usage,--warn-on-spills -Xcompiler -Wall,-Wextra,-Wnon-virtual-dtor,-Wunused,-Wshadow"
      }
    },
    {
      "name": "dev-clang-warnings",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wnon-virtual-dtor -Wunused -Wshadow",
        "CMAKE_CUDA_FLAGS": "-Wall -Wextra -Wnon-virtual-dtor -Wunused -Wshadow -Wnvcc-compat"
      }
    },
    {
      "name": "dev-clang-sanitizers",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,leak -fno-omit-frame-pointer",
        "CMAKE_CUDA_FLAGS": "-fsanitize=address,undefined,leak -fno-omit-frame-pointer"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev GCC",
      "inherits": [
        "gcc-relwithdebinfo",
        "dev-base",
        "dev-gcc-warnings"
      ]
    },
    {
      "name": "dev-clang",
      "displayName": "Dev Clang",
      "inherits": [
        "clang-relwithdebinfo",
        "dev-base",
        "dev-clang-warnings"
      ]
    },
    {
      "name": "dev-clang-sanitized",
      "displayName": "Dev Clang Sanitized",
      "inherits": [
        "clang-relwithdebinfo",
        "dev-base",
        "dev-clang-sanitizers"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-relwithdebinfo",
      "displayName": "GCC Release with Debug Info",
      "configurePreset": "gcc-relwithdebinfo"
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-relwithdebinfo",
      "displayName": "Clang Release with Debug Info",
      "configurePreset": "clang-relwithdebinfo"
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev GCC",
      "configurePreset": "dev-gcc"
    },
    {
      "name": "dev-clang",
      "displayName": "Dev Clang",
      "configurePreset": "dev-clang"
    },
    {
      "name": "dev-clang-sanitized",
      "displayName": "Dev Clang Sanitized",
      "configurePreset": "dev-clang-sanitized"
    }
  ],
  "workflowPresets": [
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-release"
        },
        {
          "type": "build",
          "name": "gcc-release"
        }
      ]
    },
    {
      "name": "gcc-relwithdebinfo",
      "displayName": "GCC Release with Debug Info",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "gcc-relwithdebinfo"
        }
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "steps": [
        {
          "type": "configure",
          "name": "clang-release"
        },
        {
          "type": "build",
          "name": "clang-release"
        }
      ]
    },
    {
      "name": "clang-relwithdebinfo",
      "displayName": "Clang Release with Debug Info",
      "steps": [
        {
          "type": "configure",
          "name": "clang-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "clang-relwithdebinfo"
        }
      ]
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev GCC",
      "steps": [
        {
          "type": "configure",
          "name": "dev-gcc"
        },
        {
          "type": "build",
          "name": "dev-gcc"
        }
      ]
    },
    {
      "name": "dev-clang",
      "displayName": "Dev Clang",
      "steps": [
        {
          "type": "configure",
          "name": "dev-clang"
        },
        {
          "type": "build",
          "name": "dev-clang"
        }
      ]
    },
    {
      "name": "dev-clang-sanitized",
      "displayName": "Dev Clang Sanitized",
      "steps": [
        {
          "type": "configure",
          "name": "dev-clang-sanitized"
        },
        {
          "type": "build",
          "name": "dev-clang-sanitized"
        }
      ]
    }
  ]
}
